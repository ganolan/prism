SCHOOLOGY_BASE_URL=https://api.schoology.com
SCHOOLOGY_CONSUMER_KEY=your_schoology_consumer_key_here
SCHOOLOGY_CONSUMER_SECRET=your_schoology_consumer_secret_here

# Optional overrides
# PORT=3001
# DB_PATH=server/db/students.db
# INBOX_DIR=inbox
# CONFIG_PATH=config.yaml

# Where `npm run db:backup` writes consistent SQLite snapshots. Point this at a
# synced/backed-up folder. Snapshots are static files, so a file syncer handles
# them safely — never sync the live students.db itself (it runs in WAL mode).
PRISM_BACKUP_DIR=/Users/you/Library/CloudStorage/OneDrive-Example/_prism-data
PRISM_BACKUP_KEEP=10
